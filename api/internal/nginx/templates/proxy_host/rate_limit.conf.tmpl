{{if .RateLimit}}{{if .RateLimit.Enabled}}
{{- $limitKey := "$binary_remote_addr"}}
{{- if eq .RateLimit.LimitBy "uri"}}{{$limitKey = "$request_uri"}}{{else if eq .RateLimit.LimitBy "ip_uri"}}{{$limitKey = "$binary_remote_addr$request_uri"}}{{end}}
# Rate limiting zone definition
# Map to exclude static files from rate limiting (empty key = no rate limit)
# Only a GET or HEAD whose path ($npg_request_path, not the query string) ends in a static
# extension; an unsafe path is "" and stays limited. So does a path with ";" (Tomcat serves
# /login;.js as /login) or a script followed by more path (PHP runs /wp-login.php/x.css).
map "$request_method:$npg_request_path" $rate_limit_key_{{sanitizeID .Host.ID}} {
    "~*\.(?:php\d?|phtml|aspx?|ashx|asmx|svc|jsp|cgi|pl)/"  {{$limitKey}};
    "~*^(?:GET|HEAD):[^;]*\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif|mp4|webm|pdf|zip|tar|gz|rar)$"  "";
    default  {{$limitKey}};
}
{{- $id := sanitizeID .Host.ID}}
# Rate limit exceptions and global trusted IPs bypass the zone (empty key = no
# rate limit). The chain is written whole even when both lists are empty: a
# running nginx refuses a reload that changes the key of a zone it has, so the
# key is always $rate_final_key_{{$id}}.
geo $rate_wl_{{$id}} {
    default 0;
{{- range ipWhitelist .RateLimit.WhitelistIPs}}
    {{.}} 1;
{{- end}}
{{- range dnsGeoIncludes .RateLimit.WhitelistDNS}}
    # dns: {{commentText .Name}}
    include {{.Path}};
{{- end}}
}
map $rate_wl_{{$id}} $rate_wl_key_{{$id}} {
    1       "";
    default $rate_limit_key_{{$id}};
}
map $trusted_ip_{{$id}} $rate_final_key_{{$id}} {
    1       "";
    default $rate_wl_key_{{$id}};
}
limit_req_zone $rate_final_key_{{$id}} zone=npg_rl_{{$id}}:{{.RateLimit.ZoneSize}} rate={{.RateLimit.RequestsPerSecond}}r/s;
{{- if .LegacyRateZoneAlias}}
# The zone's name before v2.62.0, which a host's Advanced Config or the
# custom HTTP config still uses. It counts separately from the zone above.
limit_req_zone $rate_final_key_{{$id}} zone=rate_{{$id}}:{{.RateLimit.ZoneSize}} rate={{.RateLimit.RequestsPerSecond}}r/s;
{{- end}}

{{end}}{{end}}

